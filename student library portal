/**
 * -----------------------------------------------------------------
 * GUI CLASS 2: AdminView (The Admin Portal)
 * This is the NEW code you requested.
 * -----------------------------------------------------------------
 */
class AdminView extends JFrame {
    private Library library;

    // Models for the JLists
    private DefaultListModel<Student> studentModel = new DefaultListModel<>();
    private DefaultListModel<Book> availableBookModel = new DefaultListModel<>();
    private DefaultListModel<Book> issuedBookModel = new DefaultListModel<>();

    // JLists
    private JList<Student> studentList = new JList<>(studentModel);
    private JList<Book> availableBookList = new JList<>(availableBookModel);
    private JList<Book> issuedBookList = new JList<>(issuedBookModel);

    // TextFields
    private JTextField studentIdField = new JTextField(10);
    private JTextField studentNameField = new JTextField(10);
    private JTextField bookIdField = new JTextField(10);
    private JTextField bookTitleField = new JTextField(10);
    private JTextField bookAuthorField = new JTextField(10);
    private JTextField dueDaysField = new JTextField("14", 5); // Default 14 days

    public AdminView(Library library) {
        this.library = library;
        setTitle("Admin Portal - Library Management");
        setSize(1000, 700);
        setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE); // Don't exit app, just close window
        setLocationRelativeTo(null);

        JPanel mainPanel = new JPanel(new GridLayout(1, 3, 10, 10));
        mainPanel.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));

        mainPanel.add(createStudentPanel());
        mainPanel.add(createAvailableBookPanel());
        mainPanel.add(createIssuedBookPanel());

        add(mainPanel);
        refreshAllLists();
    }

    private JPanel createStudentPanel() {
        JPanel panel = new JPanel(new BorderLayout(5, 5));
        panel.setBorder(new TitledBorder("Students"));
        panel.add(new JScrollPane(studentList), BorderLayout.CENTER);

        // Form to add new student
        JPanel addStudentPanel = new JPanel(new GridLayout(3, 2, 5, 5));
        addStudentPanel.setBorder(new TitledBorder("Add New Student"));
        addStudentPanel.add(new JLabel("Student ID:"));
        addStudentPanel.add(studentIdField);
        addStudentPanel.add(new JLabel("Name:"));
        addStudentPanel.add(studentNameField);
        JButton addButton = new JButton("Add Student");
        addStudentPanel.add(new JLabel()); // Spacer
        addStudentPanel.add(addButton);

        addButton.addActionListener(e -> addStudent());

        panel.add(addStudentPanel, BorderLayout.SOUTH);
        return panel;
    }

    private JPanel createAvailableBookPanel() {
        JPanel panel = new JPanel(new BorderLayout(5, 5));
        panel.setBorder(new TitledBorder("Available Books"));
        panel.add(new JScrollPane(availableBookList), BorderLayout.CENTER);

        // --- Bottom panel with two sections ---
        JPanel southPanel = new JPanel(new GridLayout(2, 1, 5, 10));

        // 1. Form to add new book
        JPanel addBookPanel = new JPanel(new GridLayout(4, 2, 5, 5));
        addBookPanel.setBorder(new TitledBorder("Add New Book"));
        addBookPanel.add(new JLabel("Book ID:"));
        addBookPanel.add(bookIdField);
        addBookPanel.add(new JLabel("Title:"));
        addBookPanel.add(bookTitleField);
        addBookPanel.add(new JLabel("Author:"));
        addBookPanel.add(bookAuthorField);
        JButton addButton = new JButton("Add Book");
        addBookPanel.add(new JLabel()); // Spacer
        addBookPanel.add(addButton);
        
        // 2. Panel to issue a book
        JPanel issuePanel = new JPanel(new FlowLayout(FlowLayout.CENTER));
        issuePanel.setBorder(new TitledBorder("Issue Book"));
        issuePanel.add(new JLabel("Days until due:"));
        issuePanel.add(dueDaysField);
        JButton issueButton = new JButton("Issue to Selected Student");
        issuePanel.add(issueButton);

        southPanel.add(addBookPanel);
        southPanel.add(issuePanel);
        panel.add(southPanel, BorderLayout.SOUTH);

        addButton.addActionListener(e -> addBook());
        issueButton.addActionListener(e -> issueBook());

        return panel;
    }

    private JPanel createIssuedBookPanel() {
        JPanel panel = new JPanel(new BorderLayout(5, 5));
        panel.setBorder(new TitledBorder("Issued Books"));
        panel.add(new JScrollPane(issuedBookList), BorderLayout.CENTER);

        JButton returnButton = new JButton("Return Selected Book");
        returnButton.setFont(new Font("Arial", Font.BOLD, 14));
        panel.add(returnButton, BorderLayout.SOUTH);

        returnButton.addActionListener(e -> returnBook());
        return panel;
    }

    private void refreshAllLists() {
        studentModel.clear();
        availableBookModel.clear();
        issuedBookModel.clear();

        library.getAllStudents().forEach(studentModel::addElement);
        library.getAvailableBooks().forEach(availableBookModel::addElement);
        library.getIssuedBooks().forEach(issuedBookModel::addElement);
    }

    private void addStudent() {
        try {
            int id = Integer.parseInt(studentIdField.getText());
            String name = studentNameField.getText();
            if (name.isEmpty()) {
                JOptionPane.showMessageDialog(this, "Student name cannot be empty.", "Error", JOptionPane.ERROR_MESSAGE);
                return;
            }
            library.addStudent(new Student(id, name));
            studentIdField.setText("");
            studentNameField.setText("");
            refreshAllLists();
        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(this, "Invalid Student ID. Must be a number.", "Error", JOptionPane.ERROR_MESSAGE);
        }
    }

    private void addBook() {
        try {
            int id = Integer.parseInt(bookIdField.getText());
            String title = bookTitleField.getText();
            String author = bookAuthorField.getText();
            if (title.isEmpty() || author.isEmpty()) {
                JOptionPane.showMessageDialog(this, "Book title and author cannot be empty.", "Error", JOptionPane.ERROR_MESSAGE);
                return;
            }
            library.addBook(new Book(id, title, author));
            bookIdField.setText("");
            bookTitleField.setText("");
            bookAuthorField.setText("");
            refreshAllLists();
        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(this, "Invalid Book ID. Must be a number.", "Error", JOptionPane.ERROR_MESSAGE);
        }
    }

    private void issueBook() {
        Student selectedStudent = studentList.getSelectedValue();
        Book selectedBook = availableBookList.getSelectedValue();

        if (selectedStudent == null || selectedBook == null) {
            JOptionPane.showMessageDialog(this, "Please select a student AND an available book.", "Error", JOptionPane.WARNING_MESSAGE);
            return;
        }

        try {
            int days = Integer.parseInt(dueDaysField.getText());
            LocalDate dueDate = LocalDate.now().plusDays(days);
            library.issueBook(selectedBook, selectedStudent, dueDate);
            refreshAllLists();
        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(this, "Invalid due days. Must be a number.", "Error", JOptionPane.ERROR_MESSAGE);
        }
    }

    private void returnBook() {
        Book selectedBook = issuedBookList.getSelectedValue();
        if (selectedBook == null) {
            JOptionPane.showMessageDialog(this, "Please select an issued book to return.", "Error", JOptionPane.WARNING_MESSAGE);
            return;
        }
        library.returnBook(selectedBook);
        refreshAllLists();
    }
}


