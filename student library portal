class LoginView extends JFrame {
    private Library library;
    private JTextField studentIdField;
    private JButton loginButton;

    public LoginView(Library library) {
        this.library = library;
        setTitle("Student Portal Login");
        setSize(350, 150);
        setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
        setLocationRelativeTo(null);
        setLayout(new FlowLayout(FlowLayout.CENTER, 10, 20));

        add(new JLabel("Enter Student ID:"));
        studentIdField = new JTextField(10);
        add(studentIdField);

        loginButton = new JButton("Login");
        add(loginButton);
        loginButton.addActionListener(e -> handleLogin());
    }

    private void handleLogin() {
        try {
            int studentId = Integer.parseInt(studentIdField.getText());
            Student student = library.findStudentById(studentId);
            if (student != null) {
                StudentPortalView portal = new StudentPortalView(student, library);
                portal.setVisible(true);
                this.dispose(); 
            } else {
                JOptionPane.showMessageDialog(this, "Student ID not found.", "Login Error", JOptionPane.ERROR_MESSAGE);
            }
        } catch (NumberFormatException ex) {
            JOptionPane.showMessageDialog(this, "Invalid Student ID.", "Input Error", JOptionPane.WARNING_MESSAGE);
        }
    }
}

class StudentPortalView extends JFrame {
    private Student student;
    private Library library;
    private DefaultListModel<Book> availableBooksModel = new DefaultListModel<>();
    private DefaultListModel<String> myBooksModel = new DefaultListModel<>(); // Use String for custom format
    private JTextArea remindersArea = new JTextArea();

    public StudentPortalView(Student student, Library library) {
        this.student = student;
        this.library = library;

        setTitle("Student Portal - Welcome, " + student.getName());
        setSize(800, 500);
        setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
        setLocationRelativeTo(null);

        JPanel mainPanel = new JPanel(new GridLayout(1, 3, 10, 10));
        mainPanel.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10));

        // 1. Available Books Panel
        JPanel availablePanel = new JPanel(new BorderLayout());
        availablePanel.setBorder(new TitledBorder("Available Books in Library"));
        JList<Book> availableBooksList = new JList<>(availableBooksModel);
        availablePanel.add(new JScrollPane(availableBooksList), BorderLayout.CENTER);

        // 2. My Issued Books Panel
        JPanel myBooksPanel = new JPanel(new BorderLayout());
        myBooksPanel.setBorder(new TitledBorder("My Issued Books"));
        JList<String> myBooksList = new JList<>(myBooksModel);
        myBooksPanel.add(new JScrollPane(myBooksList), BorderLayout.CENTER);

        // 3. Reminders Panel
        JPanel reminderPanel = new JPanel(new BorderLayout());
        reminderPanel.setBorder(new TitledBorder("Reminders & Due Dates"));
        remindersArea.setEditable(false);
        remindersArea.setFont(new Font("Monospaced", Font.BOLD, 12));
        reminderPanel.add(new JScrollPane(remindersArea), BorderLayout.CENTER);

        mainPanel.add(availablePanel);
        mainPanel.add(myBooksPanel);
        mainPanel.add(reminderPanel);
        add(mainPanel);

        refreshLists();
    }
    
    private void refreshLists() {
        availableBooksModel.clear();
        myBooksModel.clear();

        library.getAvailableBooks().forEach(availableBooksModel::addElement);
        
        for (Book book : student.getIssuedBooks()) {
            myBooksModel.addElement("'" + book.getTitle() + "' (Due: " + book.getDueDate() + ")");
        }
        
        refreshReminders();
    }

    private void refreshReminders() {
        remindersArea.setText(""); 
        LocalDate today = LocalDate.now();
        
        if (student.getIssuedBooks().isEmpty()) {
            remindersArea.setForeground(Color.BLACK);
            remindersArea.setText("You have no books issued.");
            return;
        }

        StringBuilder reminderText = new StringBuilder();
        boolean overdue = false;
        
        for (Book book : student.getIssuedBooks()) {
            if (book.getDueDate().isBefore(today)) {
                reminderText.append("!! OVERDUE !!\n");
                reminderText.append("  Title: " + book.getTitle() + "\n");
                reminderText.append("  Due: " + book.getDueDate() + "\n\n");
                overdue = true;
            } else {
                reminderText.append("  REMINDER\n");
                reminderText.append("  Title: " + book.getTitle() + "\n");
                reminderText.append("  Due: " + book.getDueDate() + "\n\n");
            }
        }
        remindersArea.setText(reminderText.toString());
        remindersArea.setForeground(overdue ? Color.RED : new Color(0, 100, 0)); // Red or dark green
    }
}


/**
 * -----------------------------------------------------------------
 * MODEL CLASSES (Data Backend)
 * -----------------------------------------------------------------
 */
class Book {
    private int id;
    private String title;
    private String author;
    private boolean isIssued = false;
    private Student issuedTo = null;
    private LocalDate dueDate = null;

    public Book(int id, String title, String author) {
        this.id = id;
        this.title = title;
        this.author = author;
    }

    public int getId() { return id; }
    public String getTitle() { return title; }
    public String getAuthor() { return author; }
    public boolean isIssued() { return isIssued; }
    public Student getIssuedTo() { return issuedTo; }
    public LocalDate getDueDate() { return dueDate; }

    public void setIssued(boolean issued) { isIssued = issued; }
    public void setIssuedTo(Student student) { issuedTo = student; }
    public void setDueDate(LocalDate dueDate) { this.dueDate = dueDate; }

    /**
     * This toString() is now used by the ADMIN portal JLists.
     * It provides a different view depending on if the book is issued.
     */
    @Override
    public String toString() {
        if (isIssued) {
            return "ID: " + id + " - '" + title + "' (Issued to: " + issuedTo.getName() + ")";
        }
        return "ID: " + id + " - '" + title + "' by " + author;
    }
}

class Student {
    private int studentId;
    private String name;
    private List<Book> issuedBooks = new ArrayList<>();

    public Student(int studentId, String name) {
        this.studentId = studentId;
        this.name = name;
    }

    public int getStudentId() { return studentId; }
    public String getName() { return name; }
    public List<Book> getIssuedBooks() { return issuedBooks; }

    public void issueBook(Book book) { issuedBooks.add(book); }
    public void returnBook(Book book) { issuedBooks.remove(book); }

    @Override
    public String toString() {
        return "ID: " + studentId + " - " + name;
    }
}

class Library {
    private List<Book> allBooks = new ArrayList<>();
    private List<Student> allStudents = new ArrayList<>();

    // --- Getters for Lists (Used by GUI) ---
    public List<Student> getAllStudents() { return allStudents; }
    
    public List<Book> getAvailableBooks() {
        return allBooks.stream()
                .filter(book -> !book.isIssued())
                .collect(Collectors.toList());
    }
    
    public List<Book> getIssuedBooks() {
        return allBooks.stream()
                .filter(Book::isIssued)
                .collect(Collectors.toList());
    }

    // --- Data Management (Used by Admin) ---
    public void addBook(Book book) { allBooks.add(book); }
    public void addStudent(Student student) { allStudents.add(student); }

    public Student findStudentById(int id) {
        return allStudents.stream()
                .filter(s -> s.getStudentId() == id)
                .findFirst()
                .orElse(null);
    }

    // --- Core Operations (Used by Admin) ---
    public void issueBook(Book book, Student student, LocalDate dueDate) {
        if (book != null && student != null && !book.isIssued()) {
            book.setIssued(true);
            book.setIssuedTo(student);
            book.setDueDate(dueDate);
            student.issueBook(book);
        }
    }

    public void returnBook(Book book) {
        if (book != null && book.isIssued()) {
            book.getIssuedTo().returnBook(book);
            book.setIssued(false);
            book.setIssuedTo(null);
            book.setDueDate(null);
        }
    }
}
